@page "/it"
@using CheaperThanAi.Shared.dto
@inject HttpClient Http

<h3>IT View</h3>

<div class="mb-3">
    <input @bind="query" @bind:event="oninput" class="form-control" placeholder="Search tickets..." />
</div>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="SearchAsync" disabled="@isLoading">Search</button>
    <button class="btn btn-secondary ms-2" @onclick="Clear">Clear</button>
    @if (isLoading)
    {
        <span class="ms-3">Loading...</span>
    }
    </div>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (results?.Count > 0)
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Score</th>
                <th>Id</th>
                <th>Date</th>
                <th>User</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Issue</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in results)
            {
                <tr>
                    <td>@r.Score</td>
                    <td>@r.Id</td>
                    <td>@r.DateTime</td>
                    <td>@r.UserName</td>
                    <td>@r.Category</td>
                    <td>@r.PriorityLevel</td>
                    <td>@r.IssueDescription</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!isLoading && !string.IsNullOrWhiteSpace(query))
{
    <div class="mt-3">No results.</div>
}

@code {
    private string query = string.Empty;
    private List<TicketSearchResult> results = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task SearchAsync()
    {
        errorMessage = null;
        results.Clear();

        if (string.IsNullOrWhiteSpace(query))
        {
            errorMessage = "Please enter search terms.";
            return;
        }

        isLoading = true;
        try
        {
            var url = $"https://localhost:7170/api/tickets/search?q={Uri.EscapeDataString(query)}";
            var resp = await Http.GetFromJsonAsync<List<TicketSearchResult>>(url);
            if (resp != null)
            {
                results = resp;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Clear()
    {
        query = string.Empty;
        results.Clear();
        errorMessage = null;
    }
}
