@page "/"
@using CheaperThanAi.Shared.Requests
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http

<PageTitle>IT Support Bot</PageTitle>

<div class="page">
    <h1>IT Support Bot</h1>
    <p class="subtitle">Describe your issue and submit a request.</p>

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmit">
        <div class="field">
            <label for="name">Name</label>
            <InputText id="name"
                       @bind-Value="_request.Name"
                       placeholder="Your name"
                       disabled="@_isSubmitting"
                       @onblur="(FocusEventArgs _) => OnFieldBlur(nameof(SupportRequest.Name))" />
            <ValidationMessage For="() => _request.Name" />
        </div>

        <div class="field">
            <label for="email">Email</label>
            <InputText id="email"
                       @bind-Value="_request.Email"
                       type="email"
                       placeholder="you@example.com"
                       disabled="@_isSubmitting"
                       @onblur="(FocusEventArgs _) => OnFieldBlur(nameof(SupportRequest.Email))" />
            <ValidationMessage For="() => _request.Email" />
        </div>
        <div class="field">
            <label for="message">Request</label>
            <InputTextArea id="message"
                           @bind-Value="_request.Message"
                           rows="8"
                           placeholder="What do you need help with?"
                           disabled="@_isSubmitting"
                           @onblur="(FocusEventArgs _) => OnFieldBlur(nameof(SupportRequest.Message))" />
            <ValidationMessage For="() => _request.Message" />
        </div>

        <button type="submit" disabled="@(_isSubmitting || !_isValid)">
            @(_isSubmitting ? "Submitting..." : "Submit")
        </button>
        @if (_submitAttempted && !_isValid)
        {
            <div class="error" role="alert">Please fix the errors in the form above.</div>
        }
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_responseMessage))
    {
        <div class="response" role="status">@_responseMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error" role="alert">@_errorMessage</div>
    }
</div>

@code {
    private readonly SupportRequest _request = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private HashSet<string> _touchedFields = new();
    private bool _isValid = true; // start true so submit button is enabled; validation runs on blur or submit
    private bool _submitAttempted;
    private string? _responseMessage;
    private string? _errorMessage;
    private bool _isSubmitting;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_request);
        _messageStore = new ValidationMessageStore(_editContext);

        // When the form requests full validation (e.g. on submit), run full model validation
        _editContext.OnValidationRequested += (s, e) => ValidateModel();
    }

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _responseMessage = null;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/requests", _request);
            response.EnsureSuccessStatusCode();

            var result = await response.Content.ReadFromJsonAsync<SupportResponse>();
            _responseMessage = result?.Message ?? "No response received.";
            // clear submit attempt marker on success
            _submitAttempted = false;
        }
        catch (Exception)
        {
            _errorMessage = "Unable to submit your request. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }

    }

    private async Task HandleSubmit(EditContext editContext)
    {
        _submitAttempted = true;
        ValidateModel();

        if (!_isValid)
        {
            // don't proceed with submission; show field errors and the red summary below the button
            StateHasChanged();
            return;
        }

        await SubmitAsync();
    }
    private void ValidateModel()
    {
        _messageStore.Clear();

        var validationResults = new List<ValidationResult>();
        var context = new ValidationContext(_request, serviceProvider: null, items: null);
        Validator.TryValidateObject(_request, context, validationResults, validateAllProperties: true);

        foreach (var validationResult in validationResults)
        {
            foreach (var memberName in validationResult.MemberNames)
            {
                var field = new FieldIdentifier(_request, memberName);
                _messageStore.Add(field, validationResult.ErrorMessage);
            }
        }

        _editContext.NotifyValidationStateChanged();

        // Update overall validity
        _isValid = !validationResults.Any();
    }

    private void ValidateField(FieldIdentifier field)
    {
        _messageStore.Clear(field);

        var results = new List<ValidationResult>();
        var property = _request.GetType().GetProperty(field.FieldName);
        var value = property?.GetValue(_request);
        var context = new ValidationContext(_request) { MemberName = field.FieldName };
        Validator.TryValidateProperty(value, context, results);

        foreach (var r in results)
        {
            _messageStore.Add(field, r.ErrorMessage);
        }

        _editContext.NotifyValidationStateChanged();

        // Recompute overall validity by running a lightweight full validation
        var allResults = new List<ValidationResult>();
        Validator.TryValidateObject(_request, new ValidationContext(_request), allResults, validateAllProperties: true);
        _isValid = !allResults.Any();
    }

    private void OnFieldBlur(string propertyName)
    {
        if (_editContext is null) return;

        _touchedFields.Add(propertyName);
        var field = new FieldIdentifier(_request, propertyName);
        _editContext.NotifyFieldChanged(field);
        ValidateField(field);
    }
}
